server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /diagram.svg {
        add_header Cache-Control "public, max-age=86400";
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'";
    }
}
